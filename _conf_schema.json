{
  "api_config": {
    "description": "生图接口配置",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "生图接口提供商（4.5 / 默认）",
        "hint": "选择 AstrBot 系统提供商，/nai 与 /nai0（4.5 档）使用；插件会读取该提供商的 API 地址与 Key。",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      },
      "provider_id_v5": {
        "description": "V5 生图接口提供商（可选）",
        "hint": "/nai5 与 V5 档专用；留空则复用上方提供商（同一网关支持两个模型时无需重复填写）。",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      },
      "nai0_model": {
        "description": "/nai0 使用的模型",
        "hint": "原始提示词模式（/nai0）走 4.5 还是 V5；提供商跟随所选模型（V5 档优先用上方 V5 提供商）。",
        "type": "string",
        "default": "nai-diffusion-4-5-full",
        "options": [
          "nai-diffusion-4-5-full",
          "nai-diffusion-5-full"
        ]
      }
    }
  },
  "generation_config": {
    "description": "生图参数",
    "type": "object",
    "items": {
      "sampler": {
        "description": "采样器",
        "type": "string",
        "hint": "k_euler_ancestral：推荐默认，随机性较强，二次元效果稳定；k_euler：更稳定干净，随机性较低；k_dpmpp_2s_ancestral：细节和质感较好，随机性较强，但部分代理可能不支持",
        "default": "k_euler_ancestral",
        "options": [
          "k_euler_ancestral",
          "k_euler",
          "k_dpmpp_2s_ancestral"
        ]
      },
      "default_ratio": {
        "description": "默认比例",
        "type": "string",
        "hint": "当提示词未指定比例时使用。支持 16:9、9:16、4:3、3:4、3:2、2:3、1:1、5:4、4:5、7:4、4:7、12:5、5:12、21:9、9:21，也可写横屏、竖屏、方图",
        "default": "2:3 (832×1216)",
        "options": [
          "16:9 (1216×704)",
          "9:16 (704×1216)",
          "4:3 (1024×768)",
          "3:4 (768×1024)",
          "3:2 (1216×832)",
          "2:3 (832×1216)",
          "1:1 (1024×1024)",
          "5:4 (960×768)",
          "4:5 (768×960)",
          "7:4 (1344×768)",
          "4:7 (768×1344)",
          "12:5 (1536×640)",
          "5:12 (640×1536)",
          "21:9 (1344×576)",
          "9:21 (576×1344)"
        ]
      },
      "max_concurrency": {
        "description": "生图并发限制",
        "type": "int",
        "hint": "同一时刻最多同时进行的生图任务数，超过设定值新的请求会排队等待",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 9,
          "step": 1
        }
      }
    }
  },
  "prompt_config": {
    "description": "提示词拼接配置",
    "type": "object",
    "items": {
      "quality_prompt": {
        "description": "质量提示词",
        "type": "string",
        "hint": "自动追加到最终正面提示词末尾，留空则不追加。",
        "default": "best quality, amazing quality, very aesthetic, absurdres"
      },
      "negative_prompt": {
        "description": "负面提示词",
        "type": "string",
        "hint": "全局生效的负面提示词，插件会在代码中固定追加 QQ 安全负面词。",
        "default": "lowres, bad anatomy, bad hands, text, error, missing fingers"
      },
      "artist_presets": {
        "description": "画师预设列表",
        "type": "list",
        "hint": "预设名:画师提示词。输入 /nai 预设名 可切换预设；输入 /nai 预设名 提示词 可临时调用。",
        "items": {
          "type": "string",
          "description": "预设名:画师提示词"
        },
        "default": [
          "可爱:artist:ciloranko , [artist:sho_(sho_lwlw)], [[artist:tianliang_duohe_fangdongye]],[[[[[[artist:kani_biimu]]]]]]",
          "幼态:artist: ciloranko, [artist: tianliang duohe fangdongye], [artist: sho_(sho_lwlw)], [artist: baku-p], [artist:tsubasa_tsubasa], [[artist:as109]], [[artist:rhasta]]",
          "水彩:{hokori sakuni}, {ciloranko}, {ke-ta}, {houkisei},{kedama milk}",
          "海报:artist:ciloranko, {artist:menthako}, {artist:tianliang duohe fangdongye}, [artist:sho (sho lwlw)], [artist:baku-p], [[[artist:tsubasa tsubasa]]], artist: kemo camotli",
          "鲜艳色彩:[artist:ningen_mame], {{{ciloranko}}}, [artist:sho_(sho_lwlw)], [[artist:rhasta]], [artist:wlop], [artist:ke-ta]"
        ]
      }
    }
  },
  "translator_config": {
    "description": "中文提示词翻译配置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用中文转提示词",
        "type": "bool",
        "hint": "开启后 /nai 中文描述会自动调用翻译器转为英文 Danbooru tag",
        "default": false
      },
      "provider_id": {
        "description": "翻译接口提供商",
        "hint": "选择 AstrBot 系统提供商。",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      },
      "show_result": {
        "description": "显示翻译结果",
        "type": "bool",
        "hint": "开启后会在生图前发送翻译得到的英文提示词，便于调试",
        "default": false
      }
    }
  },
  "image_retag_config": {
    "description": "图片反推提示词配置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用图片反推提示词",
        "type": "bool",
        "hint": "开启后，/nai 引用图片或附带图片时，会先调用视觉模型把图片反推为 NovelAI / Danbooru tags，再进行生图",
        "default": false
      },
      "provider_id": {
        "description": "图片反推接口提供商",
        "hint": "选择支持视觉输入的 AstrBot 系统提供商。用于把图片转换为 NovelAI 绘图提示词 tags",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      },
      "show_result": {
        "description": "显示反推结果",
        "type": "bool",
        "hint": "开启后会在生图前发送反推得到的 tags，便于调试",
        "default": false
      }
    }
  },
  "safety_config": {
